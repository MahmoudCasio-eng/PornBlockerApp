<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="match_parent"
 android:orientation="vertical" android:gravity="center" android:padding="24dp"
 android:layoutDirection="rtl">
 <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
  android:text="حماية من المحتوى غير اللائق" android:textSize="26sp" android:textStyle="bold"/>
 <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
  android:layout_marginTop="20dp" android:gravity="center"
  android:text="متصفح آمن يمنع الدومينات الموجودة في قائمة الحظر ويعرض رسالة تذكير عند محاولة الوصول إليها."
  android:textSize="17sp"/>
 <Button android:id="@+id/openBrowser" android:layout_width="match_parent"
  android:layout_height="wrap_content" android:layout_marginTop="32dp"
  android:text="فتح المتصفح الآمن" android:textAllCaps="false"/>
</LinearLayout>
